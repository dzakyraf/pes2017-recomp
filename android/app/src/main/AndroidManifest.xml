<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vibration for the controller's rumble; the player can turn it off. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading the disc image the player supplies. On Android 13 and later
         a plain file path outside the app's own folders needs the manage
         permission; the app asks for it only when the player picks a folder
         it cannot otherwise read, and works without it when the image sits
         in Android/data/<package>/files. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Saves and caches are written beside a game folder chosen outside the app. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Self-update: downloading the next APK and installing it over this one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Checking for a newer APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The run's process has to stay wanted while the game is up, and for a
         process nobody is looking at a foreground service is the only way to
         say so (GameService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x400000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name=".PES17Application"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@style/Theme.PES17">

        <!-- The game modes the system may offer for this game (res/xml/game_mode_config.xml). -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The run lives in its own process. It is ended by killing that
             process, which is the only way to stop a guest that is inside
             recompiled code, and it must not take the launcher with it. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:theme="@style/Theme.PES17.Game"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|navigation|keyboard|touchscreen|smallestScreenSize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- In the run's own process, so the notification and the game share
             one: a service in the launcher's process would keep the wrong thing
             alive and let the :game process be killed anyway. Its type is
             "special use" because that is what a game session held open for a
             player who has stepped away is. -->
        <service
            android:name=".GameService"
            android:exported="false"
            android:process=":game"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A game session in progress" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ControlsEditorActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.PES17.Game"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".DriverActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".InstallActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
