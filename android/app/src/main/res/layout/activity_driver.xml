<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pes_page">

    <include layout="@layout/view_back_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/graphics_driver"
        android:textColor="@color/pes_navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/driver_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/pes_panel"
        android:padding="12dp"
        android:textColor="@color/pes_text"
        android:textSize="13sp" />

    <TextView
        style="@style/SettingHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/driver_hint" />

    <Button
        android:id="@+id/download_driver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/download_driver" />

    <Button
        android:id="@+id/import_driver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/import_driver" />

    <ListView
        android:id="@+id/driver_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:divider="@color/pes_line"
        android:dividerHeight="1dp" />
    </LinearLayout>
</LinearLayout>
