<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pes_page">

    <include layout="@layout/view_back_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/captures_title"
            android:textColor="@color/pes_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/captures_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/pes_panel"
            android:padding="12dp"
            android:textColor="@color/pes_text"
            android:textSize="13sp" />

        <TextView
            style="@style/SettingHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/captures_hint" />

        <ListView
            android:id="@+id/captures_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:divider="@color/pes_line"
            android:dividerHeight="1dp" />

        <Button
            android:id="@+id/captures_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/captures_clear_all" />
    </LinearLayout>
</LinearLayout>
